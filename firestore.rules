rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }
    match /orders/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /deposits/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /codes/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn()
                    && request.resource.data.used == true && resource.data.used == false);
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /products/{pid} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /settings/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /admin/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /notif_log/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}
